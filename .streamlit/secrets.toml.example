# ============================================================
# .streamlit/secrets.toml 示例
# 用法：复制为 .streamlit/secrets.toml 后填入真实值
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# 注意：secrets.toml 已在 .gitignore 中排除，请勿提交真实密钥。
# ============================================================

# DeepSeek API Key（src/llm_client.py、src/ai_analyst.py 使用）
DEEPSEEK_API_KEY = "sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# MySQL 连接（src/db.py；也可以改用环境变量 TAOBAO_DB_USER / TAOBAO_DB_PASSWORD）
[mysql]
user = "root"
password = "your-mysql-password"

# QQ 邮箱 SMTP：注册审核邮件通知（password 填 QQ 邮箱生成的 16 位授权码）
[smtp]
host = "smtp.qq.com"
port = 465
user = "your@qq.com"
password = "your-smtp-auth-code"
sender = "your@qq.com"
